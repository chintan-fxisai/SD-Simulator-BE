APP_NAME=SD Simulator API
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/sd_simulator

JWT_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
